{
  "info": {
    "name": "Payments and Notifications - Member 7",
    "description": "Member 7 endpoints. Run the folders in order (Collection Runner works too).\n\nBefore running:\n1. Start the backend (npm run start:dev) with STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and PLATFORM_CURRENCY in backend/.env.\n2. Run stripe listen --events \"payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled,refund.updated,refund.failed\" --forward-to localhost:3000/api/payments/webhook so the booking gets confirmed.\n3. Set the collection variables email and password to a registered user (role user).\n\nAuth uses the httpOnly cookies set by Login; Postman keeps them automatically.\nThe hotel booking requests (Maya's endpoints) are only used to get a booking to pay for.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "25abf204-81b0-4f26-9506-f9b65188ab92"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "hotelId",
      "value": "665f1c2e8b3a4d0012a3b0aa"
    },
    {
      "key": "roomId",
      "value": "665f1c2e8b3a4d0012a3b0c2"
    },
    {
      "key": "checkIn",
      "value": ""
    },
    {
      "key": "checkOut",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "refundId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sets the access_token cookie (15 min). Run it again if a request returns 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Logged in as a user', () => pm.expect(pm.response.json().role).to.eql('user'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Setup - hotel booking (Member 6)",
      "item": [
        {
          "name": "Create hotel booking (PendingPayment, 10-min hold)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotel-bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"rooms\": [\n    {\n      \"roomId\": \"{{roomId}}\",\n      \"adults\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Only used to get a booking to pay for. The next requests must run within 10 minutes."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A random free night between 1 Dec 2026 and 30 Jan 2027, so the collection can be re-run.",
                  "const start = new Date(Date.UTC(2026, 11, 1));",
                  "const day = new Date(start.getTime() + Math.floor(Math.random() * 60) * 86400000);",
                  "const next = new Date(day.getTime() + 86400000);",
                  "pm.collectionVariables.set('checkIn', day.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('checkOut', next.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', b._id);",
                  "pm.test('Booking is PendingPayment', () => pm.expect(b.status).to.eql('PendingPayment'));"
                ]
              }
            }
          ]
        }
      ]
    },
