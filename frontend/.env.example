# Backend origin used by the Next.js rewrite proxy (server-side only).
BACKEND_URL=http://localhost:3000

# Public URL used for page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Stripe test publishable key. Never commit a real key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The single platform currency used by the backend (PAY-04). Defaults to USD.
NEXT_PUBLIC_PLATFORM_CURRENCY=USD
